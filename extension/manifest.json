{
  "manifest_version": 3,
  "name": "SyncWatch",
  "version": "0.2.0",
  "description": "Совместный просмотр видео: синхронизация play/pause/seek до 10 человек.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SyncWatch — показать/скрыть островок"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
