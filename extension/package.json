{
  "name": "syncwatch-extension",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:chrome": "node esbuild.config.mjs --chrome",
    "build:firefox": "node esbuild.config.mjs --firefox",
    "watch": "node esbuild.config.mjs --chrome --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
