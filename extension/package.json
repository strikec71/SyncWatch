{
  "name": "syncwatch-extension",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:chrome": "node esbuild.config.mjs --chrome",
    "watch": "node esbuild.config.mjs --chrome --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run verify && npm run build && node scripts/package.mjs",
    "verify": "npm run typecheck && npm test",
    "test:browser": "node ../docs/audit/fullscreen-check.mjs && node ../docs/audit/design-check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
