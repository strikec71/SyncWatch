{
  "manifest_version": 3,
  "name": "SyncWatch",
  "version": "0.2.0",
  "description": "Совместный просмотр видео: синхронизация play/pause/seek до 10 человек.",
  "browser_specific_settings": {
    "gecko": {
      "id": "syncwatch@local",
      "strict_min_version": "121.0",
      "update_url": "https://syncwatch-signal.strikec71.workers.dev/updates.json"
    }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "SyncWatch — показать/скрыть островок"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
